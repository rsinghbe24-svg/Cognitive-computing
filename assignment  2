# QUESTION 3: RANDOM NUMBERS & LOGIC
# ==========================================
print("=== QUESTION 3: RANDOM NUMBERS ===")

# Set random seed
random.seed(ROLL_NUMBER_INT)

# i. Generate 100 random numbers between 100 and 900 (inclusive)
rand_nums = [random.randint(100, 900) for _ in range(100)]

# ii. Count odd numbers
odd_nums = [x for x in rand_nums if x % 2 != 0]
print(f"ii. Odd numbers count: {len(odd_nums)}")

# iii. Count even numbers
even_nums = [x for x in rand_nums if x % 2 == 0]
print(f"iii. Even numbers count: {len(even_nums)}")

# iv. Count and list prime numbers
def is_prime(n):
    if n < 2:
        return False
    for i in range(2, int(n**0.5) + 1):
        if n % i == 0:
            return False
    return True

prime_nums = [x for x in rand_nums if is_prime(x)]
print(f"iv. Prime numbers count: {len(prime_nums)}")
print(f"    List of prime numbers: {prime_nums}")

# v. Most frequent number
freq_counter = Counter(rand_nums)
most_common_num, most_common_count = freq_counter.most_common(1)[0]
print(f"v. Most frequent number: {most_common_num} (occurs {most_common_count} times)\n")


