print("=== QUESTION 5: DICTIONARIES ===")

my_dict = {
    "name": "Alex",
    "roll_no": ROLL_NUMBER_STR,
    "branch": "Computer Science",
    "age": 20,
    "city": "Patiala"
}

# i. Rename key "city" to "location"
my_dict["location"] = my_dict.pop("city")
print(f"i. Renamed key 'city' to 'location': {my_dict}")

# ii. Add key "cgpa"
my_dict["cgpa"] = 9.1
print(f"ii. Added 'cgpa': {my_dict}")

# iii. Update "age"
my_dict["age"] += 1
print(f"iii. Updated age: {my_dict}")

# iv. Delete "branch" using two methods
dict_copy1 = my_dict.copy()
dict_copy2 = my_dict.copy()

val_pop = dict_copy1.pop("branch")
del dict_copy2["branch"]
# pop() returns the removed value, whereas del directly deletes the key-value pair and returns nothing.

# v. Iterate using .items()
print("v. Dictionary Key-Value pairs:")
for key, value in my_dict.items():
    print(f"   {key} -> {value}")

# vi. Safe key check using 'in'
print("vi. Key existence check:")
if "email" in my_dict:
    print(f"   Email: {my_dict['email']}")
else:
    print("   Fallback: 'email' key does not exist in the dictionary.")

# vii. Merge with friend_dict
friend_dict = {
    "name": "Sam",
    "roll_no": "1021039999",
    "branch": "Mechanical",
    "age": 21,
    "city": "Chandigarh"
}
merged_dict = {**my_dict, **friend_dict}
# When two dictionaries share keys during unpacking, the values from the second dictionary override the first.
print(f"vii. Merged Dictionary: {merged_dict}")

# viii. Dictionary comprehension for string values
str_only_dict = {k: v for k, v in my_dict.items() if isinstance(v, str)}
print(f"viii. String values only: {str_only_dict}")
