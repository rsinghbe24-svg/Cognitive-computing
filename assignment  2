# QUESTION 4: SETS
# ==========================================
print("=== QUESTION 4: SETS ===")

# Using first 8 digits of roll number
first_8_digits = original_digits[:8]

set_A = {digit * 7 for digit in first_8_digits}
set_B = {digit * 9 for digit in first_8_digits}
print(f"Set A: {set_A}")
print(f"Set B: {set_B}")

# vi. Union
print(f"vi. Union (A | B): {set_A.union(set_B)}")

# vii. Intersection
print(f"vii. Intersection (A & B): {set_A.intersection(set_B)}")

# viii. Difference and comparison comment
diff_A_B = set_A.difference(set_B)
diff_B_A = set_B.difference(set_A)
print(f"viii. A - B: {diff_A_B}")
print(f"      B - A: {diff_B_A}")
# difference() returns elements in one specific set only, whereas symmetric_difference() returns elements present in either set but not both.

# ix. Symmetric Difference
print(f"ix. Symmetric Difference: {set_A.symmetric_difference(set_B)}")

# x. Subset and Superset
print(f"x. Is A subset of B? {set_A.issubset(set_B)}")
print(f"   Is B superset of A? {set_B.issuperset(set_A)}")

# xi. Discard vs Remove
x_val_str = input("xi. Enter a value X to discard from Set A: ")
if x_val_str.isdigit():
    x_val = int(x_val_str)
    set_A.discard(x_val)
    # discard() silently skips non-existent elements, whereas remove() raises a KeyError.
    print(f"    Set A after discarding {x_val}: {set_A}\n")


