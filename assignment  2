import random
from collections import Counter


ROLL_NUMBER_STR = "1021034567"  # 10-digit roll number as string
ROLL_NUMBER_INT = int(ROLL_NUMBER_STR)

#### QUESTION 1: LISTS
print("=== QUESTION 1: LISTS ===")
original_digits = [int(digit) for digit in ROLL_NUMBER_STR]
L = [digit * 10 for digit in original_digits]
print(f"i. Initial List L: {L}")
L.append(99)
 append() adds the element to the very end of the list.
print(f"ii. After append(99): {L}")

L.insert(2, 45)
 insert(index, value) places the element at index 2, shifting subsequent items right.
print(f"    After insert(2, 45): {L}")

 iii. Remove two elements (remove and pop)
L.remove(45)  # Removes the first occurrence of 45
print(f"iii. After remove(45): {L}")

popped_val = L.pop(0)  # Removes and returns element at index 0
print(f"     After pop(0) (removed {popped_val}): {L}")

 iv. Sort ascending and descending
L.sort()
print(f"iv. Ascending order: {L}")

L.sort(reverse=True)
print(f"    Descending order: {L}")

print(f"v. First three elements: {L[:3]}")
print(f"   Last three elements: {L[-3:]}")


avg_L = sum(L) / len(L)
above_avg = [x for x in L if x > avg_L]
print(f"vi. Average = {avg_L:.2f}, Elements > average: {above_avg}\n")



# QUESTION 2: TUPLES

print("=== QUESTION 2: TUPLES ===")


scores = tuple(L[:8])
print(f"Tuple 'scores': {scores}")


max_score = max(scores)
max_idx = scores.index(max_score)
min_score = min(scores)
min_count = scores.count(min_score)
print(f"i. Highest score: {max_score} at index {max_idx}")
print(f"   Lowest score: {min_score}, appears {min_count} time(s)")


# Tuples cannot be reversed in-place because they are immutable; a new reversed list must be constructed.
reversed_scores_list = list(reversed(scores))
print(f"ii. Reversed scores as list: {reversed_scores_list}")


user_score_str = input("iii. Enter a score to search in tuple: ")
if user_score_str.isdigit():
    user_score = int(user_score_str)
    if user_score in scores:
        print(f"     Score {user_score} found at first occurrence index: {scores.index(user_score)}")
    else:
        print(f"     Score {user_score} is not present in the tuple.")

# iv. Attempting modification and error handling
try:
    scores[0] = 100
except TypeError as e:
    # Tuples are immutable and lack item assignment support, unlike mutable lists.
    print(f"iv. Captured Error: {e}")

# v. Unpacking using * operator
first, second, *remaining = scores
print(f"v. Unpacked -> First: {first}, Second: {second}, Remaining: {remaining}\n")


