# ==========================================
# Q2. Array Reversal and Mode/Indices Finding
# ==========================================
# a) Reverse the array
arr2 = np.array([1, 2, 3, 6, 4, 5])
reversed_arr2 = arr2[::-1]

# b) Find most frequent value and their indices
# Helper function for mode and indices
def get_most_frequent_and_indices(arr):
    vals, counts = np.unique(arr, return_counts=True)
    max_count = np.max(counts)
    most_frequent_vals = vals[counts == max_count]
    indices_dict = {
        val: np.where(arr == val)[0].tolist() for val in most_frequent_vals
    }
    return most_frequent_vals, indices_dict


x = np.array([1, 2, 3, 4, 5, 1, 2, 1, 1, 1])
y = np.array([1, 1, 1, 2, 3, 4, 2, 4, 3, 3])

x_mode, x_indices = get_most_frequent_and_indices(x)
y_mode, y_indices = get_most_frequent_and_indices(y)

print("Q2 Answers:")
print("a) Reversed array:", reversed_arr2)
print("b.i) Array x - Most frequent value(s):", x_mode, "| Indices:", x_indices)
print("b.ii) Array y - Most frequent value(s):", y_mode, "| Indices:", y_indices)
print("-" * 50)


