# ==========================================
# Q4. linspace Array Attributes & Transpose Behavior
# ==========================================
# Create 1D array using linspace
student_name = np.linspace(10, 100, 25)

dims = student_name.ndim
shape = student_name.shape
total_elements = student_name.size
dtype = student_name.dtype
total_bytes = student_name.nbytes

# Transpose via reshape: converting (25,) to a 2D column vector (25, 1)
reshaped_transpose = student_name.reshape(-1, 1)

# Using .T attribute on 1D array
t_attr_result = student_name.T

print("Q4 Answers:")
print(f"Dimensions: {dims}")
print(f"Shape: {shape}")
print(f"Total elements: {total_elements}")
print(f"Data type: {dtype}")
print(f"Total bytes consumed: {total_bytes} bytes")
print("Transposed using reshape(-1, 1) shape:", reshaped_transpose.shape)
print("Transposed using .T attribute shape:", t_attr_result.shape)
print(
    "Can we do the same with .T? No. The .T attribute on a 1D NumPy array returns the same 1D array unchanged because a 1D vector has no second axis to swap. reshape(-1, 1) is required to explicitly turn it into a column vector."
)
print("-" * 50)


# ==========================================
# Q5. 2D Array Statistics, Reshaping, and Resizing
# ==========================================
ucs420_student_name = np.array(
    [[10, 20, 30, 40], [50, 60, 70, 80], [90, 15, 20, 35]]
)

mean_val = np.mean(ucs420_student_name)
median_val = np.median(ucs420_student_name)
max_val = np.max(ucs420_student_name)
min_val = np.min(ucs420_student_name)
unique_elements = np.unique(ucs420_student_name)

# Reshape into 4x3 matrix
reshaped_ucs420_student_name = ucs420_student_name.reshape(4, 3)

# Resize to 2x3 matrix
resized_ucs420_student_name = np.resize(ucs420_student_name, (2, 3))

print("Q5 Answers:")
print("Mean:", mean_val)
print("Median:", median_val)
print("Max:", max_val)
print("Min:", min_val)
print("Unique Elements:", unique_elements)
print("\nReshaped Array (4x3):\n", reshaped_ucs420_student_name)
print("\nResized Array (2x3):\n", resized_ucs420_student_name)
