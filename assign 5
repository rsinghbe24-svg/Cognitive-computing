import numpy as np

# ==========================================
# Q1. Sensor Readings (Vectorization & Boolean Indexing)
# ==========================================
temperature = np.array([25, 28, 31, 35, 38, 27, 33, 40])

# a. Add 2°C using vectorization
temp_corrected = temperature + 2

# b. Convert to Fahrenheit
temp_fahrenheit = (9 / 5) * temperature + 32

# c. Identify readings > 32°C using Boolean indexing
readings_gt_32 = temperature[temperature > 32]

# d. Count how many readings exceed 32°C
count_gt_32 = np.sum(temperature > 32)

print("Q1 Answers:")
print("a. Temperature + 2°C:", temp_corrected)
print("b. Temperature in Fahrenheit:", temp_fahrenheit)
print("c. Readings > 32°C:", readings_gt_32)
print("d. Count of readings > 32°C:", count_gt_32)
print(
    "e. Explanation: Vectorization runs operations on entire arrays at compiled C-speed, avoiding Python loop overhead. Boolean indexing creates a binary mask to filter elements without conditional statements."
)
print("-" * 50)


# ==========================================
# Q2. Step Count Matrix Operations
# ==========================================
steps = np.array(
    [
        [5000, 6200, 7100],
        [8000, 7500, 9000],
        [4500, 5100, 4800],
        [9000, 8500, 9500],
    ]
)

# a. Total steps
total_steps = np.sum(steps)

# b. Mean steps
mean_steps = np.mean(steps)

# c. Max and Min
max_steps = np.max(steps)
min_steps = np.min(steps)

# d. Total steps per day (axis=0)
daily_total = np.sum(steps, axis=0)

# e. Total steps per user (axis=1)
user_total = np.sum(steps, axis=1)

# f. Position of maximum steps using argmax()
# 1D flattened index converted to (user, day) coordinates
max_flat_idx = np.argmax(steps)
max_pos = np.unravel_index(max_flat_idx, steps.shape)

print("Q2 Answers:")
print("a. Total steps:", total_steps)
print("b. Mean steps:", mean_steps)
print("c. Max steps:", max_steps, "| Min steps:", min_steps)
print("d. Daily total steps (axis=0):", daily_total)
print("e. User total steps (axis=1):", user_total)
print(
    f"f. Argmax position (user index, day index): {max_pos} (Flat index: {max_flat_idx})"
)
print("-" * 50)


# ==========================================
# Q3. Array Manipulation, Slicing & Views vs Copies
# ==========================================
# a. Original array
original = np.array([1, 2, 3, 4, 5, 6])

# b. Slice index 1 to 4
subset = original[1:4]

# c. Modify subset element
subset[0] = 999
print("Q3 Answers:")
print("c. After modifying subset[0] = 999:")
print("   subset:", subset)
print("   original (affected due to view):", original)

# d. Slice with .copy()
subset_copy = original[1:4].copy()
subset_copy[0] = 500
print("d. After modifying subset_copy[0] = 500:")
print("   copied array:", subset_copy)
print("   original (unaffected):", original)

# e. Reshape 1 to 12 into 3x4 matrix
matrix_3x4 = np.arange(1, 13).reshape(3, 4)
print("\ne. 3x4 Matrix:\n", matrix_3x4)

# f. Indexing and Slicing
first_row = matrix_3x4[0]
last_row = matrix_3x4[-1]
second_col = matrix_3x4[:, 1]
sub_matrix = matrix_3x4[1:3, 2:4]

print("f. Extracted elements:")
print("   First row:", first_row)
print("   Last row:", last_row)
print("   Second column:", second_col)
print("   Rows 1-2 & Cols 2-3:\n", sub_matrix)

# g. Flattening
flat_arr = matrix_3x4.flatten()
rav_arr = matrix_3x4.ravel()

# h. Modify ravel() array
rav_arr[0] = 777
print("\nh. Ravel modification:")
print("   matrix_3x4[0,0] (affected):", matrix_3x4[0, 0])

# i. Modify flatten() array
flat_arr[1] = 888
print("i. Flatten modification:")
print("   matrix_3x4[0,1] (unaffected):", matrix_3x4[0, 1])

# j. Attributes
print("j. Attributes of 3x4 Matrix:")
print(
    f"   Shape: {matrix_3x4.shape}, ndim: {matrix_3x4.ndim}, Size: {matrix_3x4.size}, Dtype: {matrix_3x4.dtype}"
)
print("-" * 50)


# ==========================================
# Q4. Cognitive-Assistive System (OLS Regression)
# ==========================================
X = np.array([[6, 70, 3], [5, 50, 6], [8, 80, 2], [4, 30, 8]])

y = np.array([40, 65, 30, 85])

# a. Shape and Dimensions
shape_X = X.shape
ndim_X = X.ndim

# b. Transpose
X_T = X.T

# c. Matrix product X.T @ X
XT_X = X_T @ X

# d. Matrix Inverse
XT_X_inv = np.linalg.inv(XT_X)

# e. OLS Equation: beta = inverse(X.T @ X) @ X.T @ y
beta = XT_X_inv @ X_T @ y

# g. Prediction for new user
new_user = np.array([5, 40, 7])
predicted_score = new_user @ beta

print("Q4 Answers:")
print("a. Shape of X:", shape_X, "| Dimensions of X:", ndim_X)
print("b. X Transposed (X.T):\n", X_T)
print(
    "   Explanation: X.T flips rows into columns, changing features per user to feature columns across users."
)
print("c. Matrix product X.T @ X:\n", XT_X)
print("d. Inverse (X.T @ X)^-1:\n", XT_X_inv)
print("e. Calculated Coefficients (beta):", beta)
print(
    "f. Explanation: Each coefficient shows how much the predicted assistance score changes per unit increase in Sleep, Activity, and Stress respectively."
)
print(f"g. Predicted Assistance Score for new user {new_user}:", predicted_score)
